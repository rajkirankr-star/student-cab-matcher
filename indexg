<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Student Airport Cab Matcher</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen p-4 sm:p-6">

  <div class="max-w-5xl mx-auto space-y-6">
    <!-- Header -->
    <header class="border-b border-slate-800 pb-4">
      <h1 class="text-2xl font-bold text-sky-400">Student Airport Cab Matcher</h1>
      <p class="text-slate-400 text-xs mt-1">Connected to Central Firebase Cloud Database. Real-time multi-user synchronization active.</p>
    </header>

    <!-- 1. Input Form -->
    <section class="bg-slate-800 p-5 rounded-xl border border-slate-700 shadow-md">
      <h2 class="text-lg font-semibold mb-3 text-slate-200">Enter Travel Details</h2>
      <form id="tripForm" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-3">
        <div>
          <label class="block text-xs text-slate-400 mb-1">Student Name</label>
          <input type="text" id="studentName" required class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-1.5 text-sm focus:outline-none focus:border-sky-500 text-white" placeholder="Rahul Sharma" />
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1">Airline Name</label>
          <select id="airline" required class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-1.5 text-sm focus:outline-none focus:border-sky-500 text-white">
            <option value="" disabled selected>Select Airline</option>
            <option value="Indigo">Indigo</option>
            <option value="Akasa">Akasa</option>
            <option value="Air India">Air India</option>
            <option value="Other">Other</option>
          </select>
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1">Source Location</label>
          <select id="source" required class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-1.5 text-sm focus:outline-none focus:border-sky-500 text-white">
            <option value="" disabled selected>Select City</option>
            <option value="Bangalore">Bangalore</option>
            <option value="Kolkata">Kolkata</option>
          </select>
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1">Start Date</label>
          <select id="startDate" required class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-1.5 text-sm focus:outline-none focus:border-sky-500 text-white">
            <option value="" disabled selected>Select Date</option>
            <option value="16th Oct">16th Oct</option>
            <option value="17th Oct">17th Oct</option>
            <option value="18th Oct">18th Oct</option>
            <option value="24th Oct">24th Oct</option>
            <option value="25th Oct">25th Oct</option>
            <option value="26th Oct">26th Oct</option>
          </select>
        </div>
        <div>
          <label class="block text-xs text-slate-400 mb-1">Start Time</label>
          <input type="time" id="startTime" required class="w-full bg-slate-900 border border-slate-700 rounded px-3 py-1.5 text-sm focus:outline-none focus:border-sky-500 text-white" />
        </div>
        <div class="flex items-end">
          <button type="submit" id="submitBtn" class="w-full bg-sky-600 hover:bg-sky-500 font-medium py-1.5 px-3 rounded text-sm transition text-white">Add Entry</button>
        </div>
      </form>

      <!-- Suggested Times Pills -->
      <div id="suggestedTimesContainer" class="mt-4 pt-3 border-t border-slate-700 hidden">
        <span class="text-xs text-amber-400 font-medium block mb-1.5">💡 Suggested Start Times (Existing active pools looking for cabmates):</span>
        <div id="timePills" class="flex flex-wrap gap-2"></div>
      </div>
    </section>

    <!-- 2. Master Table -->
    <section class="bg-slate-800 p-5 rounded-xl border border-slate-700 shadow-md">
      <div class="flex justify-between items-center mb-3">
        <h2 class="text-lg font-semibold text-slate-200">All Student Entries</h2>
        <span id="entryCount" class="text-xs bg-slate-700 px-2.5 py-1 rounded-full text-slate-300">0 Total</span>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-slate-300">
          <thead class="bg-slate-900 text-slate-400 uppercase text-xs">
            <tr>
              <th class="p-2.5">Student</th>
              <th class="p-2.5">Airline</th>
              <th class="p-2.5">Source</th>
              <th class="p-2.5">Date</th>
              <th class="p-2.5">Time</th>
              <th class="p-2.5 text-right">Action</th>
            </tr>
          </thead>
          <tbody id="tableBody" class="divide-y divide-slate-700">
            <!-- Dynamic rows populated from Firebase -->
          </tbody>
        </table>
      </div>
    </section>

    <!-- 3. Cab Grouping by Source Location -->
    <section class="bg-slate-800 p-5 rounded-xl border border-slate-700 shadow-md space-y-6">
      <div>
        <h2 class="text-lg font-semibold text-slate-200">Cab Pickup Groups (Max 4 per cab)</h2>
        <p class="text-xs text-slate-400">Automatically organized into location sections and grouped by matching Date & Time.</p>
      </div>

      <!-- Bangalore Section -->
      <div class="border border-slate-700 rounded-lg p-4 bg-slate-850">
        <div class="flex items-center justify-between mb-3 border-b border-slate-700 pb-2">
          <h3 class="text-md font-bold text-sky-400 flex items-center gap-2">
            📍 Bangalore Departures
          </h3>
          <span id="blrCount" class="text-xs bg-sky-900/60 text-sky-300 px-2 py-0.5 rounded-full border border-sky-700">0 Passengers</span>
        </div>
        <div id="blrCabContainer" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          <!-- Dynamic Bangalore Cab Cards -->
        </div>
      </div>

      <!-- Kolkata Section -->
      <div class="border border-slate-700 rounded-lg p-4 bg-slate-850">
        <div class="flex items-center justify-between mb-3 border-b border-slate-700 pb-2">
          <h3 class="text-md font-bold text-amber-400 flex items-center gap-2">
            📍 Kolkata Departures
          </h3>
          <span id="ccuCount" class="text-xs bg-amber-900/60 text-amber-300 px-2 py-0.5 rounded-full border border-amber-700">0 Passengers</span>
        </div>
        <div id="ccuCabContainer" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          <!-- Dynamic Kolkata Cab Cards -->
        </div>
      </div>
    </section>
  </div>

  <!-- Firebase Modular SDK -->
  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
    import { getDatabase, ref, push, remove, onValue } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-database.js";

    // Your Firebase Credentials
    const firebaseConfig = {
      apiKey: "AIzaSyCYPZvGvYmALHz1uzWvS8vU4NMjaXf5pDg",
      authDomain: "cabproj1-c1c9d.firebaseapp.com",
      databaseURL: "https://cabproj1-c1c9d-default-rtdb.firebaseio.com",
      projectId: "cabproj1-c1c9d",
      storageBucket: "cabproj1-c1c9d.firebasestorage.app",
      messagingSenderId: "435784812404",
      appId: "1:435784812404:web:55a07f72732c4f25c24e21",
      measurementId: "G-76LPZCW7G8"
    };

    // Initialize Firebase
    const app = initializeApp(firebaseConfig);
    const db = getDatabase(app);
    const tripsRef = ref(db, 'trips');

    let globalTrips = [];

    // Add entry to Central Database
    document.getElementById('tripForm').addEventListener('submit', (e) => {
      e.preventDefault();
      const newTrip = {
        studentName: document.getElementById('studentName').value,
        airline: document.getElementById('airline').value,
        source: document.getElementById('source').value,
        startDate: document.getElementById('startDate').value,
        startTime: document.getElementById('startTime').value,
        timestamp: Date.now()
      };
      
      push(tripsRef, newTrip);
      document.getElementById('tripForm').reset();
      updateTimeSuggestions();
    });

    // Delete entry from Central Database
    window.deleteTrip = function(id) {
      const tripItemRef = ref(db, `trips/${id}`);
      remove(tripItemRef);
    };

    // Live sync listener for real-time updates across all users
    onValue(tripsRef, (snapshot) => {
      const data = snapshot.val();
      globalTrips = [];
      if (data) {
        Object.keys(data).forEach(key => {
          globalTrips.push({ id: key, ...data[key] });
        });
      }
      renderAll(globalTrips);
    });

    // Dynamic Time Suggestions when Source or Date changes
    document.getElementById('source').addEventListener('change', updateTimeSuggestions);
    document.getElementById('startDate').addEventListener('change', updateTimeSuggestions);

    function updateTimeSuggestions() {
      const source = document.getElementById('source').value;
      const startDate = document.getElementById('startDate').value;
      const suggestionsContainer = document.getElementById('suggestedTimesContainer');
      const timePills = document.getElementById('timePills');

      if (!source || !startDate) {
        suggestionsContainer.classList.add('hidden');
        return;
      }

      // Find matching entries for selected city & date
      const matching = globalTrips.filter(t => t.source === source && t.startDate === startDate);
      
      if (matching.length === 0) {
        suggestionsContainer.classList.add('hidden');
        return;
      }

      // Group counts per time
      const timeCounts = {};
      matching.forEach(t => {
        timeCounts[t.startTime] = (timeCounts[t.startTime] || 0) + 1;
      });

      timePills.innerHTML = Object.entries(timeCounts).map(([time, count]) => {
        const remainingSeats = 4 - (count % 4);
        return `
          <button type="button" onclick="selectSuggestedTime('${time}')" class="bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 border border-amber-500/40 text-xs px-2.5 py-1 rounded-md transition flex items-center gap-1.5">
            <span>⏰ ${time}</span>
            <span class="bg-amber-500/30 text-amber-200 text-[10px] px-1.5 py-0.2 rounded">${count} student(s) • ${remainingSeats} seat(s) open</span>
          </button>
        `;
      }).join('');

      suggestionsContainer.classList.remove('hidden');
    }

    window.selectSuggestedTime = function(time) {
      document.getElementById('startTime').value = time;
    };

    function renderAll(trips) {
      document.getElementById('entryCount').textContent = `${trips.length} Total`;
      renderTable(trips);
      renderCabGroupsByLocation(trips);
      updateTimeSuggestions();
    }

    function renderTable(trips) {
      const tableBody = document.getElementById('tableBody');
      if (trips.length === 0) {
        tableBody.innerHTML = `<tr><td colspan="6" class="p-4 text-center text-slate-500">No entries saved in central database.</td></tr>`;
        return;
      }
      tableBody.innerHTML = trips.map(t => `
        <tr class="hover:bg-slate-700/50">
          <td class="p-2.5 font-medium text-white">${t.studentName}</td>
          <td class="p-2.5">${t.airline}</td>
          <td class="p-2.5">${t.source}</td>
          <td class="p-2.5">${t.startDate}</td>
          <td class="p-2.5">${t.startTime}</td>
          <td class="p-2.5 text-right">
            <button onclick="deleteTrip('${t.id}')" class="bg-rose-500/20 text-rose-400 hover:bg-rose-600 hover:text-white px-2.5 py-1 rounded text-xs transition">
              Delete
            </button>
          </td>
        </tr>
      `).join('');
    }

    function renderCabGroupsByLocation(trips) {
      const blrTrips = trips.filter(t => t.source === 'Bangalore');
      const ccuTrips = trips.filter(t => t.source === 'Kolkata');

      document.getElementById('blrCount').textContent = `${blrTrips.length} Passenger(s)`;
      document.getElementById('ccuCount').textContent = `${ccuTrips.length} Passenger(s)`;

      renderLocationCards('blrCabContainer', blrTrips);
      renderLocationCards('ccuCabContainer', ccuTrips);
    }

    function renderLocationCards(containerId, locationTrips) {
      const container = document.getElementById(containerId);
      if (locationTrips.length === 0) {
        container.innerHTML = `<p class="text-slate-500 text-xs col-span-full py-2">No entries scheduled for this location yet.</p>`;
        return;
      }

      // Group by matching Start Date and Start Time
      const grouped = {};
      locationTrips.forEach(t => {
        const key = `${t.startDate} @ ${t.startTime}`;
        if (!grouped[key]) grouped[key] = [];
        grouped[key].push(t);
      });

      let html = '';
      Object.entries(grouped).forEach(([timeSlot, passengers]) => {
        for (let i = 0; i < passengers.length; i += 4) {
          const cabBatch = passengers.slice(i, i + 4);
          const cabIndex = Math.floor(i / 4) + 1;
          const isFull = cabBatch.length === 4;

          html += `
            <div class="bg-slate-900 rounded-lg p-3.5 border ${isFull ? 'border-emerald-500/50' : 'border-sky-500/40'}">
              <div class="flex justify-between items-center mb-2.5">
                <span class="text-[11px] font-semibold uppercase px-2 py-0.5 rounded ${isFull ? 'bg-emerald-500/20 text-emerald-300' : 'bg-sky-500/20 text-sky-300'}">
                  Cab #${cabIndex} (${cabBatch.length}/4)
                </span>
                <span class="text-xs text-slate-400 font-medium">${timeSlot}</span>
              </div>
              <ul class="space-y-1.5">
                ${cabBatch.map(p => `
                  <li class="text-xs bg-slate-800 p-2 rounded flex justify-between items-center">
                    <span class="font-medium text-slate-200">${p.studentName}</span>
                    <span class="text-slate-400 text-[11px]">${p.airline}</span>
                  </li>
                `).join('')}
              </ul>
            </div>
          `;
        }
      });

      container.innerHTML = html;
    }
  </script>
</body>
</html>
